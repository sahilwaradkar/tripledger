rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmailLower() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : "";
    }

    function isOwner(ownerId) {
      return signedIn() && request.auth.uid == ownerId;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function groupData(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function adminIdsForGroup(groupId) {
      let group = groupData(groupId);
      return group.get('adminIds', [group.createdById]);
    }

    function isGroupAdmin(groupId) {
      return isGroupMember(groupId)
        && request.auth.uid in adminIdsForGroup(groupId);
    }

    function isJoiningGroup(groupId) {
      return signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.name == resource.data.name
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.inviteToken == resource.data.inviteToken
        && request.resource.data.createdById == resource.data.createdById
        && request.resource.data.get('adminIds', [request.resource.data.createdById])
          == resource.data.get('adminIds', [resource.data.createdById]);
    }

    function isAdminAddingMember(groupId) {
      return isGroupAdmin(groupId)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.name == resource.data.name
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.inviteToken == resource.data.inviteToken
        && request.resource.data.createdById == resource.data.createdById
        && request.resource.data.get('adminIds', [request.resource.data.createdById])
          == resource.data.get('adminIds', [resource.data.createdById]);
    }

    function isAdminRemovingMember(groupId) {
      return isGroupAdmin(groupId)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
        && request.resource.data.name == resource.data.name
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.inviteToken == resource.data.inviteToken
        && request.resource.data.createdById == resource.data.createdById;
    }

    function isAdminSettingsUpdate(groupId) {
      return isGroupAdmin(groupId)
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.get('adminIds', [request.resource.data.createdById])
          == resource.data.get('adminIds', [resource.data.createdById])
        && request.resource.data.inviteToken == resource.data.inviteToken
        && request.resource.data.createdById == resource.data.createdById;
    }

    function guestEmailMatchesAuth() {
      return resource.data.kind == 'guest'
        && resource.data.email != null
        && authEmailLower() == resource.data.email.lower();
    }

    function participantMatchesAuth(groupId, participantId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/participants/$(participantId))
        && (
          participantId == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupId)/participants/$(participantId)).data.get('userId', '') == request.auth.uid
          || get(/databases/$(database)/documents/groups/$(groupId)/participants/$(participantId)).data.get('claimedByUserId', '') == request.auth.uid
        );
    }

    function canRecordSettlement(groupId) {
      let fromId = request.resource.data.fromParticipantId;
      let toId = request.resource.data.toParticipantId;
      return isGroupAdmin(groupId)
        || participantMatchesAuth(groupId, fromId)
        || participantMatchesAuth(groupId, toId);
    }

    function validSettlementCreate(groupId) {
      let group = groupData(groupId);
      return request.resource.data.fromParticipantId != request.resource.data.toParticipantId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency == group.currency
        && request.resource.data.recordedByUserId == request.auth.uid
        && request.resource.data.fromParticipantId is string
        && request.resource.data.toParticipantId is string
        && request.resource.data.date is string;
    }

    function isAutoOffsetSettlement() {
      return request.resource.data.get('kind', 'payment') == 'auto_offset';
    }

    function validAutoOffsetCreate(groupId, settlementId) {
      let group = groupData(groupId);
      return settlementId.matches('mutual_.*')
        && isAutoOffsetSettlement()
        && request.resource.data.referenceKey is string
        && request.resource.data.referenceKey.size() > 0
        && validSettlementCreate(groupId);
    }

    function validAutoOffsetUpdate() {
      return resource.data.get('kind', 'payment') == 'auto_offset'
        && request.resource.data.kind == 'auto_offset'
        && request.resource.data.referenceKey == resource.data.referenceKey
        && request.resource.data.fromParticipantId == resource.data.fromParticipantId
        && request.resource.data.toParticipantId == resource.data.toParticipantId
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.recordedByUserId == resource.data.recordedByUserId
        && request.resource.data.amount is number
        && request.resource.data.amount > 0;
    }

    match /userEmails/{email} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && email == authEmailLower();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /trips/{tripId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /expenses/{expenseId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /groups/{groupId} {
      allow create: if signedIn()
        && request.resource.data.createdById == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds
        && request.auth.uid in request.resource.data.adminIds;

      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow update: if signedIn() && (
        isAdminSettingsUpdate(groupId)
        || isAdminAddingMember(groupId)
        || isAdminRemovingMember(groupId)
        || isJoiningGroup(groupId)
        || (
          isGroupMember(groupId)
          && !(request.auth.uid in resource.data.adminIds)
          && resource.data.adminIds.size() == 0
          && request.auth.uid == resource.data.createdById
          && request.resource.data.adminIds == [request.auth.uid]
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.name == resource.data.name
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.inviteToken == resource.data.inviteToken
          && request.resource.data.createdById == resource.data.createdById
        )
      );

      allow delete: if isGroupAdmin(groupId);

      match /participants/{participantId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupAdmin(groupId) || (
          isGroupMember(groupId) && participantId == request.auth.uid
        );

        allow update: if isGroupAdmin(groupId) || (
          isGroupMember(groupId)
          && guestEmailMatchesAuth()
          && request.resource.data.kind == 'member'
        ) || (
          isGroupMember(groupId)
          && resource.data.kind == 'guest'
          && request.resource.data.kind == 'member'
          && request.resource.data.userId == request.auth.uid
        );

        allow delete: if isGroupAdmin(groupId) || (
          isGroupMember(groupId)
          && resource.data.kind == 'guest'
          && guestEmailMatchesAuth()
        );
      }

      match /expenses/{expenseId} {
        allow read, create: if isGroupMember(groupId);
        allow update, delete: if isGroupAdmin(groupId);
      }

      match /settlements/{settlementId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && (
          (
            !isAutoOffsetSettlement()
            && validSettlementCreate(groupId)
            && canRecordSettlement(groupId)
          )
          || validAutoOffsetCreate(groupId, settlementId)
        );
        allow delete: if isGroupAdmin(groupId)
          || (isGroupMember(groupId) && resource.data.get('kind', 'payment') == 'auto_offset');
        allow update: if isGroupMember(groupId) && validAutoOffsetUpdate();
      }
    }

    match /invites/{token} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdById == request.auth.uid;
      allow delete: if signedIn() && resource.data.createdById == request.auth.uid;
    }
  }
}
